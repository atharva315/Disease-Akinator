# Copy this file to .env and replace every placeholder.
# Never commit the populated .env file.

DISEASE_AKINATOR_POSTGRES_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require
DISEASE_AKINATOR_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
DISEASE_AKINATOR_MONGODB_DATABASE=disease_akinator
